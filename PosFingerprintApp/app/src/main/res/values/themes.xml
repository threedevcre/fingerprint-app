<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PosFingerprint" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/signal</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/teal</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorControlNormal">@color/text_secondary</item>

        <item name="android:fontFamily">@font/plex</item>
        <item name="fontFamily">@font/plex</item>

        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>

        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="textInputStyle">@style/Widget.App.TextInput</item>
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
    </style>

    <!-- Android 12+ splash: logo on vault ink, then the app theme -->
    <style name="Theme.PosFingerprint.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.PosFingerprint</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/plex_semibold</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/plex_semibold</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/plex_semibold</item>
    </style>

    <style name="Widget.App.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="startIconTint">@color/text_secondary</item>
    </style>

    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/bg</item>
        <item name="titleTextAppearance">@style/Text.ScreenTitle</item>
    </style>

    <!-- Type scale (IBM Plex Sans) -->
    <style name="Text" />
    <style name="Text.ScreenTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/plex_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="Text.Display">
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">@font/plex_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="Text.Section">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">@font/plex_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="Text.ItemTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/plex_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/plex_regular</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="Text.Meta">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/plex_regular</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Text.Badge">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/plex_semibold</item>
    </style>
</resources>
