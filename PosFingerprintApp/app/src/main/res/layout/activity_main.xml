<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/logo_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/Text.ScreenTitle" />

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Text.Meta" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_settings"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Hero: this phone's identity card -->
            <FrameLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_hero"
                android:elevation="4dp">

                <!-- Glowing fingerprint: soft light, blurred ridges (Android 12+), crisp ridges -->
                <FrameLayout
                    android:id="@+id/heroGlow"
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="-46dp"
                    android:layout_marginEnd="-88dp"
                    android:importantForAccessibility="no">

                    <View
                        android:id="@+id/heroGlowLight"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/hero_glow_light" />

                    <ImageView
                        android:id="@+id/heroRidgesBlur"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.9"
                        android:padding="34dp"
                        android:src="@drawable/hero_ridges"
                        app:tint="@color/glow_online" />

                    <ImageView
                        android:id="@+id/heroRidges"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.42"
                        android:padding="34dp"
                        android:src="@drawable/hero_ridges"
                        app:tint="@color/glow_online" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_glass"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp">

                        <View
                            android:id="@+id/dotStatus"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_circle" />

                        <TextView
                            android:id="@+id/tvPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:textAppearance="@style/Text.Badge"
                            android:textColor="@color/white" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/Text.Display"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/tvHeroSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/Text.Body"
                        android:textColor="@color/hero_text_dim" />

                    <TextView
                        android:id="@+id/tvHeroNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_pill_glass"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:textAppearance="@style/Text.Meta"
                        android:textColor="@color/white"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/statsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatPos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plex_semibold"
                                android:textColor="@color/white"
                                android:textSize="24sp" />

                            <TextView
                                android:id="@+id/tvStatPosLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:text="Terminals"
                                android:textAppearance="@style/Text.Meta"
                                android:textColor="@color/hero_text_dim" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="16dp"
                            android:background="@color/hero_glass" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatProfiles"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plex_semibold"
                                android:textColor="@color/white"
                                android:textSize="24sp" />

                            <TextView
                                android:id="@+id/tvStatProfilesLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:text="Fingerprints"
                                android:textAppearance="@style/Text.Meta"
                                android:textColor="@color/hero_text_dim" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="16dp"
                            android:background="@color/hero_glass" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatToday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plex_semibold"
                                android:textColor="@color/white"
                                android:textSize="24sp" />

                            <TextView
                                android:id="@+id/tvStatTodayLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:text="Today"
                                android:textAppearance="@style/Text.Meta"
                                android:textColor="@color/hero_text_dim" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSetup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="Connect to Odoo"
                        android:textColor="@color/ink"
                        android:visibility="gone"
                        app:backgroundTint="@color/white"
                        app:icon="@drawable/ic_link"
                        app:iconGravity="textStart"
                        app:iconTint="@color/ink" />
                </LinearLayout>
            </FrameLayout>

            <!-- Odoo sign-ins (shown once this phone has an Odoo user fingerprint or sign-ins) -->
            <LinearLayout
                android:id="@+id/sectionWeb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"
                    android:text="Odoo sign-ins"
                    android:textAppearance="@style/Text.Section" />

                <LinearLayout
                    android:id="@+id/listWeb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- POS terminals -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="POS terminals"
                    android:textAppearance="@style/Text.Section" />

                <TextView
                    android:id="@+id/tvCountPos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/surface_alt"
                    android:minWidth="28dp"
                    android:gravity="center"
                    android:paddingStart="9dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="2dp"
                    android:textAppearance="@style/Text.Badge"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/listPos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <include
                android:id="@+id/emptyPos"
                layout="@layout/view_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Fingerprints -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fingerprints on this phone"
                    android:textAppearance="@style/Text.Section" />

                <TextView
                    android:id="@+id/tvCountProfiles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/surface_alt"
                    android:minWidth="28dp"
                    android:gravity="center"
                    android:paddingStart="9dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="2dp"
                    android:textAppearance="@style/Text.Badge"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/listProfiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <include
                android:id="@+id/emptyProfiles"
                layout="@layout/view_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Activity -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="Recent activity"
                android:textAppearance="@style/Text.Section" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/listActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </com.google.android.material.card.MaterialCardView>

            <include
                android:id="@+id/emptyActivity"
                layout="@layout/view_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/text_tertiary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Fingerprints never leave this phone"
                    android:textAppearance="@style/Text.Meta"
                    android:textColor="@color/text_tertiary" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
