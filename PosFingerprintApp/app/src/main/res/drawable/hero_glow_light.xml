<?xml version="1.0" encoding="utf-8"?>
<!-- Soft light behind the hero fingerprint. White here; tinted to the status colour in code
     (the default SRC_IN tint keeps this gradient's transparency). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="130dp"
        android:startColor="#73FFFFFF"
        android:centerColor="#26FFFFFF"
        android:endColor="#00FFFFFF" />
</shape>
